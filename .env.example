# Verde Dhan environment template. Copy to .env.local (dev) or set in the host panel.
# Never commit real values. Every secret below is read on the server only.
# See docs/ENVIRONMENT_VARIABLES.md for what each one does.

NODE_ENV=production
APP_URL=https://your-domain.example

# Synthetic, clearly labelled demo data. Ignored in production unless ALLOW_DEMO_IN_PRODUCTION=true.
DEMO_MODE=false
ALLOW_DEMO_IN_PRODUCTION=false

# Supabase (Auth, Postgres, RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server/worker only; bypasses RLS, used by jobs

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=high

# WhatsApp Business Cloud API (Meta)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_RECIPIENT=                   # E.164, e.g. +91XXXXXXXXXX
WHATSAPP_RECIPIENT_OPTED_IN=false     # set true only after recording opt-in consent
WHATSAPP_APP_SECRET=                  # verifies webhook signatures
WHATSAPP_WEBHOOK_VERIFY_TOKEN=        # any long random string; also entered in Meta

# Angel One SmartAPI: NSE/BSE stocks, NIFTY 50 / SENSEX, MCX commodity
# futures and NSE currency futures. Exchange websites are never scraped.
INDIA_MARKET_PROVIDER=none            # angelone | none
ANGELONE_API_KEY=                     # app key from smartapi.angelone.in
ANGELONE_CLIENT_CODE=                 # your Angel One client ID
ANGELONE_PIN=                         # your login PIN (MPIN)
ANGELONE_TOTP_SECRET=                 # setup key shown when enabling TOTP

# Global pages: TradingView widgets render in the browser only and never
# feed scores, AI evidence or WhatsApp reports.
GLOBAL_MARKET_PROVIDER=tradingview    # tradingview | none
# Server-side source for global index and Brent numbers
GLOBAL_DATA_PROVIDER=none             # cfi_mt5 | twelvedata | none
# CFI Financial MT5 bridge (Windows machine running the CFI MT5 terminal)
CFI_SYMBOL_MAP=                       # e.g. {"SPX":"US500_SPOT","NDX":"US100_Spot","DJI":"US30_SPOT","FTSE":"UK100_SPOT","DAX":"GER30_SPOT","N225":"JPN225_SPOT","BRENT":"BRENT"}
CFI_MT5_LOGIN=                        # optional if the terminal is logged in
CFI_MT5_PASSWORD=                     # investor (read-only) password
CFI_MT5_SERVER=
CFI_SERVER_UTC_OFFSET=                # optional; inferred from ticks
TWELVEDATA_API_KEY=
TWELVEDATA_SYMBOL_MAP=

# News: comma-separated RSS URLs whose terms permit this use
NEWS_RSS_FEEDS=

# Scheduler
CRON_SECRET=                          # long random string; required for /api/cron/*
NOTIFICATION_TIMEZONE=Asia/Kolkata
