# Verde Dhan environment template. Copy to .env.local (dev) or set in the host panel.
# Never commit real values. Every secret below is read on the server only.
# See docs/ENVIRONMENT_VARIABLES.md for what each one does.

NODE_ENV=production
APP_URL=https://your-domain.example

# Synthetic, clearly labelled demo data. Ignored in production unless ALLOW_DEMO_IN_PRODUCTION=true.
DEMO_MODE=false
ALLOW_DEMO_IN_PRODUCTION=false

# Supabase (Auth, Postgres, RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server/worker only; bypasses RLS, used by jobs

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=high

# WhatsApp Business Cloud API (Meta)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_RECIPIENT=                   # E.164, e.g. +91XXXXXXXXXX
WHATSAPP_RECIPIENT_OPTED_IN=false     # set true only after recording opt-in consent
WHATSAPP_APP_SECRET=                  # verifies webhook signatures
WHATSAPP_WEBHOOK_VERIFY_TOKEN=        # any long random string; also entered in Meta

# Indian market data (licensed API; exchange websites are never scraped)
INDIA_MARKET_PROVIDER=none            # upstox | none
UPSTOX_ACCESS_TOKEN=

# Global indices, forex, gold/silver
GLOBAL_MARKET_PROVIDER=none           # twelvedata | none
TWELVEDATA_API_KEY=
TWELVEDATA_SYMBOL_MAP=                # JSON, e.g. {"SPX":"SPX","NIFTY50":"NIFTY"}; depends on plan

# News: comma-separated RSS URLs whose terms permit this use
NEWS_RSS_FEEDS=

# Scheduler
CRON_SECRET=                          # long random string; required for /api/cron/*
NOTIFICATION_TIMEZONE=Asia/Kolkata
